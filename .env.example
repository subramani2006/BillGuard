# ==============================================================================
# BillGuard — Environment Variables Configuration Template (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env for local testing if needed.
# NEVER commit real credentials, passwords, or secret keys to Git!
# On Amazon Web Services (AWS), set these values in AWS App Runner / ECS Environment Variables or SSM Parameter Store.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# ------------------------------------------------------------------------------
# 2. Optional REST API Backend
# (Leave empty if running standalone; set if connecting to separate FastAPI service)
# ------------------------------------------------------------------------------
# BILLGUARD_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# 3. Amazon Web Services (AWS) — S3 Storage (Phase 5)
# Used for securely storing audit PDF representations and synthetic bill images.
# When running locally or without AWS, BillGuard automatically falls back to local disk.
# Recommended Region: ap-south-1 (Asia Pacific - Mumbai) for lowest latency in India.
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=billguard-audit-storage
# When deployed on AWS App Runner or ECS with an IAM Role, credentials are automatically inferred.
# For local development with S3 only:
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ------------------------------------------------------------------------------
# 4. Amazon Web Services (AWS) — CloudWatch Monitoring (Phase 6)
# Used for real-time application logs, error alerts, and MLOps drift metric streaming.
# In AWS App Runner, stdout logs stream automatically to CloudWatch at zero cost.
# ------------------------------------------------------------------------------
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUP=/aws/apprunner/billguard
CLOUDWATCH_METRIC_NAMESPACE=BillGuard

