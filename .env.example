# ==============================================================================
# BillGuard — Environment Variables Configuration Template (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env for local testing if needed.
# NEVER commit real credentials, passwords, or connection strings to Git!
# On Microsoft Azure, set these values in the Azure Container App Secret / Env Store.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# ------------------------------------------------------------------------------
# 2. Optional REST API Backend
# (Leave empty if running standalone; set if connecting to separate FastAPI service)
# ------------------------------------------------------------------------------
# BILLGUARD_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# 3. Microsoft Azure Blob Storage (Phase 5)
# Used for storing synthetic test bill uploads and sanitized audit PDF reports.
# When running locally or without Azure, BillGuard automatically falls back to local disk.
# ------------------------------------------------------------------------------
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account>;AccountKey=<account_key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=billguard-data

# ------------------------------------------------------------------------------
# 4. Microsoft Azure Application Insights (Phase 6)
# Used for collecting real-time HTTP metrics, latency, and operational exceptions.
# When left unset, telemetry defaults to standard local logging.
# ------------------------------------------------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
